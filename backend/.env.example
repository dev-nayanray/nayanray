# -------------------------------------------------------------------
# Backend environment variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.
# -------------------------------------------------------------------

# Database — Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# JWT secret — REQUIRED in production.
# Generate a strong one with: openssl rand -base64 48
# Min 32 chars. If unset in production, the server refuses to start.
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# Server port
PORT=5000

# Frontend URL(s) — REQUIRED in production.
# Comma-separated for multiple origins (e.g. site + admin on different ports):
#   https://nayanray.com,https://nayanray.vercel.app
# In production, CORS is fail-closed — if this is unset, the server
# refuses to start.
FRONTEND_URL=http://localhost:5173

# Node environment — set to "production" on your production host
NODE_ENV=development

# -------------------------------------------------------------------
# Admin user seeding (first-boot only)
# -------------------------------------------------------------------

# Strong admin password — REQUIRED in production.
# Min 12 chars, must include uppercase, lowercase, number, and symbol.
# Generate one with: openssl rand -base64 24
# If unset in production, the seeder refuses to create the admin user.
ADMIN_SEED_PASSWORD=StrongPassword123!

# Admin email (used for the first seeded admin account)
ADMIN_SEED_EMAIL=admin@nayanray.com

# Set to "1" ONLY on first deploy to bootstrap the first admin via
# /api/auth/register. Leave unset (default) to keep registration disabled.
# Even with this set, registration only works when zero users exist.
ENABLE_REGISTER=

# -------------------------------------------------------------------
# Supabase Storage (admin panel image uploads)
# Get these from your Supabase project: Settings -> API.
#
# SECURITY: Use SUPABASE_ANON_KEY (respects Row Level Security) instead
# of SUPABASE_SERVICE_ROLE_KEY (bypasses RLS, grants full project admin).
#
# Set up a Storage bucket with public-read RLS policies allowing
# INSERT/SELECT for anon, then use the anon key here. It can upload
# and read files but can't touch auth or the database.
#
# SUPABASE_SERVICE_ROLE_KEY is only needed for migrations/seeding that
# genuinely require elevated access. To use it, you must ALSO set
# SUPABASE_ALLOW_SERVICE_ROLE=true to acknowledge the risk.
#
# If left unset, uploads fall back to local disk at backend/uploads/
# (fine for local dev, NOT recommended for a deployed/live server since
# most hosts wipe or block local disk writes).
# -------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# SUPABASE_ALLOW_SERVICE_ROLE=false
SUPABASE_STORAGE_BUCKET=portfolio-uploads

# -------------------------------------------------------------------
# Database SSL — in production, SSL is enabled by default (encrypted
# connection). Certificate verification is OFF by default because many
# hosted Postgres providers (Supabase, Neon, etc.) use self-signed
# certificate chains that Node.js can't verify.
#
# To enable full cert verification (recommended for production):
# 1. Download your provider's root certificate (PEM format)
#    For Supabase: https://supabase.com/docs/guides/database/connecting-to-postgres
# 2. Set DB_SSL_CERT to the PEM string (or path to the file)
# This automatically enables rejectUnauthorized: true.
#
# Without DB_SSL_CERT: connection is encrypted but cert is NOT verified
# (mitigates passive eavesdropping, but not active MITM attacks).
# -------------------------------------------------------------------
# DB_SSL_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
