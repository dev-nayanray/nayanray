# Admin frontend environment variables
# Copy this file to admin/.env and fill in real values.
# NEVER commit admin/.env to git.

# Backend API URL — REQUIRED in production.
# In dev: localhost:5000 (the Express dev server)
# In production: your deployed backend URL, e.g. https://api.nayanray.com/api
#
# IMPORTANT: The backend's FRONTEND_URL env var must include the admin's
# origin (e.g. https://admin.nayanray.com) so CORS allows the cookie.
VITE_API_URL=http://localhost:5000/api
